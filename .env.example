# Find both values in Supabase: Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Alternative name used by Supabase's dashboard (same public key, sb_publishable_...).
# Set either SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY. Never use a secret/service-role key.
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
